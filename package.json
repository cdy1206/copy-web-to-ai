{
  "name": "copy-web-to-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome/Edge MV3 extension for clipping web and AI chat content into AI-ready Markdown/LaTeX, with explicit MinerU OCR fallback.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package-extension.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/turndown": "^5.0.6",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
